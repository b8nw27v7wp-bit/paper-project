{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.example"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  }
}
